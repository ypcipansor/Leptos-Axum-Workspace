{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id        AS session_id,\n            u.id        AS user_id,\n            u.username  AS username,\n            u.created_at AS user_created_at,\n            s.expires_at AS expires_at\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n        ",
