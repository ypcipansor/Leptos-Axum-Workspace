  "query": "\n        SELECT\n            id,\n            user_id,\n            user_agent,\n            ip_address AS \"ip_address: IpAddr\",\n            created_at,\n            last_seen_at,\n            expires_at\n        FROM sessions\n        WHERE user_id = $1\n          AND expires_at > now()\n        ORDER BY created_at DESC\n        ",
