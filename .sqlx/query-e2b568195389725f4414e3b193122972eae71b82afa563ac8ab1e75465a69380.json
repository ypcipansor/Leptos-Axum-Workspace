  "query": "\n        INSERT INTO sessions (user_id, token_hash, user_agent, ip_address, expires_at)\n        VALUES ($1, $2, $3, $4, now() + make_interval(secs => $5))\n        RETURNING\n            id,\n            user_id,\n            user_agent,\n            ip_address AS \"ip_address: IpAddr\",\n            created_at,\n            last_seen_at,\n            expires_at\n        ",
