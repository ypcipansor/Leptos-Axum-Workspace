root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.{css,html,js,json,md,sql,ts,toml,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_style = space
indent_size = 4
