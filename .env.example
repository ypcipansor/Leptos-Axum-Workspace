# Copy to .env and adjust. Every value here has a safe default except
# DATABASE_URL, which the process refuses to start without -- there is
# deliberately no built-in fallback connection string.

# --- Required ----------------------------------------------------------------

# Must be a postgres:// or postgresql:// URL. Validated at startup.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app

# --- Server ------------------------------------------------------------------

HOST=0.0.0.0
PORT=3000

# development | production
#
# Governs two things that must not be guessed wrong:
#   - the session cookie's Secure flag and __Host- prefix (production only)
#   - log format: human-readable here, JSON in production
APP_ENV=development

# --- Database ----------------------------------------------------------------

DATABASE_MAX_CONNECTIONS=10

# --- Sessions ----------------------------------------------------------------

# How long a session stays valid. The window slides forward while the session
# is in use. Default: 7 days.
SESSION_TTL_SECONDS=604800

# How often expired rows are swept from the sessions table. Default: 1 hour.
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# --- Proxies -----------------------------------------------------------------

# Number of trusted reverse proxies in front of this process.
#
# 0 (the default) ignores X-Forwarded-For entirely and records the TCP peer
# address. Set it only to the real number of proxies you control: the header is
# forgeable by the caller, and trusting more hops than exist lets a client
# choose the address recorded against its own sessions.
#
#   0  -> exposed directly
#   1  -> behind one nginx / Caddy / ALB
#   2  -> behind a CDN in front of that proxy
TRUSTED_PROXY_HOPS=0

# --- Logging -----------------------------------------------------------------

# Overrides the built-in default of
# "info,sqlx=warn,hyper=warn,tower_http=info,h2=warn".
# RUST_LOG=debug

# --- Tests -------------------------------------------------------------------

# Integration tests create a uniquely named database per run from this server,
# so they never collide with the development database or with each other.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# --- Docker Compose ----------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
